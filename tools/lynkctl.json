{
  "$schema": "https://cyclonedx.org/schema/tool-center-v2.tool.schema.json",
  "specVersion": "2.0",
  "tool": {
    "name": "lynkctl",
    "publisher": "Interlynk.io",
    "description": "Command-line utility that generates high-quality CycloneDX and SPDX SBOMs from C/C++ and embedded firmware projects without executing the build.",
    "repository_url": "https://github.com/interlynk-io/lynkctl-public",
    "website_url": "https://www.interlynk.io/",
    "capabilities": [
      "SBOM"
    ],
    "availability": [
      "OPEN_SOURCE",
      "OSI_APPROVED"
    ],
    "functions": [
      "ANALYSIS",
      "PACKAGE_MANAGER_INTEGRATION",
      "TRANSFORM"
    ],
    "analysis": [
      "LICENSE_REPORTING",
      "RESOURCE_REPORTING"
    ],
    "transform": [
      "BOM_SERIALIZATION_FORMAT",
      "BOM_STANDARD",
      "BOM_VERSION"
    ],
    "packaging": [
      "COMMAND_LINE_UTILITY",
      "CONTAINER_IMAGE"
    ],
    "library": [
      "GO"
    ],
    "platform": [
      "LINUX",
      "MAC",
      "WINDOWS"
    ],
    "lifecycle": [
      "PRE-BUILD",
      "BUILD",
      "POST-BUILD"
    ],
    "supportedStandards": [
      "CYCLONEDX",
      "PACKAGE_URL",
      "SPDX"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.6",
      "CYCLONEDX_V1.7"
    ],
    "supportedLanguages": [
      "C/C++",
      "GO",
      "JAVA",
      "JAVASCRIPT/TYPESCRIPT",
      ".NET",
      "NODE.JS",
      "PHP",
      "PYTHON",
      "RUBY",
      "RUST"
    ]
  }
}
